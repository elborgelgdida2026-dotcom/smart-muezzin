# No real secrets in this repo. Copy this file to `.env` locally and fill it in.
# `.env` is git-ignored — never commit it.
#
# Public APIs used by the app (no keys needed):
ALADHAN_API_BASE=https://api.aladhan.com/v1
ALQURAN_API_BASE=https://api.alquran.cloud/v1
#
# Supabase backend for the Admin Panel (see supabase/README.md).
# Get these from your Supabase project: Project Settings -> API.
# Use the ANON PUBLIC key only — never put the service_role key in the app.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY-HERE
#
# For CI builds (GitHub Actions), pass the same values as --dart-define
# instead of a .env file:
#   --dart-define=SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co \
#   --dart-define=SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY-HERE
# Without these values the app works fully in local mode and the admin
# screens show setup instructions instead of fake data.
